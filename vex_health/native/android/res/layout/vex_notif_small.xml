<?xml version="1.0" encoding="utf-8"?>
<!-- VEX — ئاگادارکردنەوەی هەنگاو (کورتکراوە): ژمارە + ڕێگای گەشت -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layoutDirection="rtl"
    android:paddingTop="2dp" android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/imHero"
            android:layout_width="wrap_content" android:layout_height="24dp"
            android:adjustViewBounds="true" android:scaleType="fitStart" />
        <TextView android:id="@+id/tvUnit"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#FF9FB7BD" android:textSize="12sp" android:text="هەنگاو" />
        <TextView android:id="@+id/tvPct"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FF2FE6F3" android:textSize="15sp" android:textStyle="bold"
            android:layoutDirection="ltr" android:text="0%" />
    </LinearLayout>

    <ImageView android:id="@+id/imTrack"
        android:layout_width="match_parent" android:layout_height="30dp"
        android:layout_marginTop="2dp"
        android:scaleType="fitCenter" />
</LinearLayout>
